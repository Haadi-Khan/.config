{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Hyper + Comma to open Finder and new window",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "comma",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command"] }
                                },
                                "to": [{ "shell_command": "open -na Finder && osascript -e 'tell application \"System Events\" to keystroke \"n\" using {command down}'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper + u to open Firefox",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "u",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command"] }
                                },
                                "to": [{ "shell_command": "open -na firefox" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper + Return to open Kitty",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": { "mandatory": ["left_control", "left_option", "left_command"] }
                                },
                                "to": [{ "shell_command": "open -na kitty" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Make caps lock into hyper key",
                        "manipulators": [
                            {
                                "description": "Change caps_lock to command+control+option+shift. Escape if no other key used.",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_option",
                                        "modifiers": ["left_command", "left_control"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
